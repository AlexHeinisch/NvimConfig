<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  Eclipse JDT formatter profile derived from the iam project conventions:
    - 4-space indentation, no tabs  (.editorconfig, FileTabCharacter checkstyle)
    - 160-character line limit      (LineLength checkstyle / .editorconfig)
    - K&R braces                    (LeftCurly EOL checkstyle)
    - Mandatory braces on all control structures (NeedBraces checkstyle)
    - No consecutive blank lines    (RegexpMultiline checkstyle)
    - Annotations on their own line (AnnotationLocation checkstyle)
    - Parameters column-aligned     (observed in ClerkEndpoint / DeviceServiceImpl)
-->
<profiles version="21">
<profile kind="CodeFormatterProfile" name="iam-style" version="21">

  <!-- ═══════════════════════════════════════════════════════════════
       INDENTATION
       ═══════════════════════════════════════════════════════════════ -->
  <setting id="org.eclipse.jdt.core.formatter.tabulation.char"                        value="space"/>
  <setting id="org.eclipse.jdt.core.formatter.tabulation.size"                        value="4"/>
  <setting id="org.eclipse.jdt.core.formatter.indentation.size"                       value="4"/>
  <setting id="org.eclipse.jdt.core.formatter.use_tabs_only_for_leading_indentation"  value="false"/>
  <!-- continuation indent = 2 levels (8 spaces) for non-column-aligned wrapping -->
  <setting id="org.eclipse.jdt.core.formatter.continuation_indentation"               value="2"/>
  <setting id="org.eclipse.jdt.core.formatter.continuation_indentation_for_array_initializer" value="2"/>

  <!-- ═══════════════════════════════════════════════════════════════
       LINE LENGTH
       ═══════════════════════════════════════════════════════════════ -->
  <setting id="org.eclipse.jdt.core.formatter.lineSplit"        value="160"/>
  <setting id="org.eclipse.jdt.core.formatter.comment.line_length" value="160"/>

